<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Talking to the WooCommerce store's PAYVI Connector REST API. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Scanning the pairing QR code (manual key entry works without this). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <!--
        Reading SMS is the core purpose of this app (matching bank/wallet
        payment SMS to orders) - this is an internal business tool meant to
        be installed directly (not distributed on the Play Store), since
        Play Store policy restricts READ_SMS/RECEIVE_SMS to default
        SMS-handler apps. See docs/SETUP.md.
    -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- Foreground service that watches for new orders + new SMS while active. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Resume the sync service after the phone restarts. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".PayviApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Payvi">

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.plugin.GetPluginActivity"
            android:exported="false"
            android:label="@string/title_get_plugin" />

        <activity
            android:name=".ui.pairing.ConnectStoreActivity"
            android:exported="false"
            android:label="@string/title_connect_store" />

        <activity
            android:name=".ui.orders.OrdersListActivity"
            android:exported="false"
            android:label="@string/title_orders" />

        <activity
            android:name=".ui.orders.OrderDetailActivity"
            android:exported="false"
            android:label="@string/title_order_detail" />

        <activity
            android:name=".ui.sms.SmsSenderSelectionActivity"
            android:exported="false"
            android:label="@string/title_sms_senders" />

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".sms.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="500">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".sms.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".service.PayviSyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
