    <!-- Get plugin -->
    <string name="plugin_intro">Install this plugin on your WooCommerce site to connect it with PAYVI.</string>
    <string name="plugin_step1">1. Share or save the plugin ZIP below.</string>
    <string name="plugin_step2">2. In WordPress admin, go to Plugins → Add New → Upload Plugin, choose the file, then click Install Now.</string>
    <string name="plugin_step3">3. Activate the plugin, then open WooCommerce → PAYVI Connector to get your pairing QR code.</string>
